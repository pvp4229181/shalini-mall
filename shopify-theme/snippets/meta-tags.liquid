{%- comment -%} Open Graph and Twitter tags built from real page data. {%- endcomment -%}
{%- liquid
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
  assign og_title = page_title | default: 'Shalini Mall' | replace: shop.name, 'Shalini Mall'
  assign og_description = page_description | default: shop.description | default: 'Shalini Mall' | replace: shop.name, 'Shalini Mall'
-%}
<meta property="og:site_name" content="Shalini Mall">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | escape }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
