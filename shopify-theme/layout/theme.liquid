<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f7ecec">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%238e3857'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='20' text-anchor='middle' fill='%23fff'%3ES%3C/text%3E%3C/svg%3E">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags %} — {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} — Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'font-faces' %}
    {{ 'tenor-sans-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.add('js');
      window.SM_CONFIG = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        artist: {{ settings.artist_name | json }},
        template: {{ template.name | json }}
      };
    </script>
    <script src="{{ 'core.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer></script>
    <script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>
    <script src="{{ 'variants.js' | asset_url }}" defer></script>
    <script src="{{ 'wall-preview.js' | asset_url }}" defer></script>
    <script src="{{ 'header.js' | asset_url }}" defer></script>
    <script src="{{ 'search.js' | asset_url }}" defer></script>
    <script src="{{ 'quick-view.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#main">Skip to content</a>
    {% sections 'header-group' %}
    <div class="scrim" data-close></div>

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}
    {% render 'search-panel' %}

    <dialog class="dialog" id="quickView" aria-labelledby="qvTitle"></dialog>
    <div class="toast" role="status" aria-live="polite"></div>

    <script src="{{ 'animations.js' | asset_url }}" defer></script>
    <script src="{{ 'product-slider.js' | asset_url }}" defer></script>
  </body>
</html>
