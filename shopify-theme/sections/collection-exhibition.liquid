{{ 'home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign c = section.settings.collection
  assign fallback_src = section.settings.fallback_image | append: '.webp' | asset_url
  assign originals_count = 0
  assign prints_count = 0
  for p in c.products limit: 250
    if p.type == settings.original_product_type or p.tags contains 'original'
      assign originals_count = originals_count | plus: 1
    else
      assign prints_count = prints_count | plus: 1
    endif
  endfor
-%}
<section class="exhibition" aria-labelledby="heading-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    {%- render 'art-image', image: section.settings.image, alt: section.settings.image.alt, sizes: '(min-width: 1024px) 58vw, 100vw' -%}
  {%- elsif c.image != blank -%}
    {%- render 'art-image', image: c.image, alt: c.title, sizes: '(min-width: 1024px) 58vw, 100vw' -%}
  {%- else -%}
    {%- render 'art-image', src: fallback_src, focus: 'center', alt: 'Detail from the collection' -%}
  {%- endif -%}
  <div class="exhibition__copy" data-reveal>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 id="heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {{ section.settings.text }}
    {%- if c != blank -%}
      <div class="exhibition__works">
        {%- for p in c.products limit: 4 -%}
          <a href="{{ p.url }}" aria-label="{{ p.title | escape }}">
            {%- render 'art-image', image: p.featured_image, focus: p.metafields.custom.image_focus.value, alt: '', sizes: '100px' -%}
          </a>
        {%- endfor -%}
      </div>
      <p class="exhibition__meta">{{ c.products_count }} works · {{ originals_count }} originals · {{ prints_count }} prints</p>
      <a class="button light" href="{{ c.url }}">{{ section.settings.button | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection story",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
    { "type": "select", "id": "fallback_image", "label": "Image before one is chosen", "default": "earth-song", "options": [{"value": "hero-gallery", "label": "Painting in a room"}, {"value": "earth-song", "label": "Earth Song"}, {"value": "wild-grace", "label": "Wild Grace"}, {"value": "quiet-orbit", "label": "Quiet Orbit"}, {"value": "small-hours", "label": "The Small Hours"}, {"value": "between-seasons", "label": "Between Seasons"}, {"value": "monsoon-memory", "label": "Monsoon Memory"}, {"value": "artist-shalini", "label": "Shalini (portrait)"}, {"value": "artist-studio", "label": "Studio table"}, {"value": "collection-hero", "label": "Collection detail"}] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Earth Song series · Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Colour as a kind of remembering." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Built slowly in layers of mineral pigment, charcoal, and translucent washes, these works hold the trace of weather, wild gardens, and remembered places.</p>" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Explore the collection" }
  ],
  "presets": [{ "name": "Collection story" }]
}
{% endschema %}
