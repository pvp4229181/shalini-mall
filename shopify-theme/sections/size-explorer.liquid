{{ 'editorial.css' | asset_url | stylesheet_tag }}
{%- comment -%} Interactive print size comparison drawn to scale (assets/wall-preview.js). {%- endcomment -%}
<section class="section" id="print-sizes" aria-labelledby="heading-{{ section.id }}">
  <div class="section-head" data-reveal>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 id="heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
  </div>
  <div class="size-explorer" data-size-explorer data-sizes="{{ section.settings.sizes | escape }}" data-src="{{ section.settings.fallback_image | append: '.webp' | asset_url }}"></div>
</section>

{% schema %}
{
  "name": "Print size guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Size guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Print sizes, to scale." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Canvas prints come in four sizes. Choose one to see it drawn to true scale on a wall. Each print page lists the sizes that work is offered in." },
    { "type": "select", "id": "fallback_image", "label": "Artwork used in the drawing", "default": "wild-grace", "options": [{"value": "hero-gallery", "label": "Painting in a room"}, {"value": "earth-song", "label": "Earth Song"}, {"value": "wild-grace", "label": "Wild Grace"}, {"value": "quiet-orbit", "label": "Quiet Orbit"}, {"value": "small-hours", "label": "The Small Hours"}, {"value": "between-seasons", "label": "Between Seasons"}, {"value": "monsoon-memory", "label": "Monsoon Memory"}, {"value": "artist-shalini", "label": "Shalini (portrait)"}, {"value": "artist-studio", "label": "Studio table"}, {"value": "collection-hero", "label": "Collection detail"}] },
    { "type": "text", "id": "sizes", "label": "Sizes to compare", "default": "8 × 10 in, 16 × 20 in, 24 × 30 in, 30 × 40 in", "info": "Match your print variants (e.g. 24 × 30 in, 30x40cm or A2), separated by commas." }
  ],
  "presets": [{ "name": "Print size guide" }]
}
{% endschema %}
