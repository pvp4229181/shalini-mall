{%- comment -%}
  Header, Shop mega menu and mobile menu.
  The menu item whose title matches "Mega menu trigger" (default "Shop") opens the mega menu.
  Mega columns come from the section's column blocks, or else from that menu item's nested links.
{%- endcomment -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
  assign trigger = section.settings.mega_trigger | downcase | strip
  assign featured = section.settings.featured_product
  assign column_blocks = section.blocks | where: 'type', 'column'
-%}

{%- capture mega_columns -%}
  {%- if column_blocks.size > 0 -%}
    {%- for block in column_blocks -%}
      <div class="mega-col" {{ block.shopify_attributes }}>
        <h2>{{ block.settings.heading | escape }}</h2>
        <ul>
          {%- for link in linklists[block.settings.menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}{% if link.type == 'collection_link' %}{% unless link.url contains '?' %}<small>({{ link.object.all_products_count }})</small>{% endunless %}{% endif %}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  {%- else -%}
    {%- for link in menu.links -%}
      {%- assign link_title = link.title | downcase | strip -%}
      {%- if link_title == trigger -%}
        {%- for group in link.links -%}
          <div class="mega-col">
            <h2>{{ group.title | escape }}</h2>
            <ul>
              {%- for child in group.links -%}
                <li><a href="{{ child.url }}">{{ child.title | escape }}{% if child.type == 'collection_link' %}{% unless child.url contains '?' %}<small>({{ child.object.all_products_count }})</small>{% endunless %}{% endif %}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture mega_feature -%}
  {%- if featured != blank -%}
    <a class="mega-feature" href="{{ featured.url }}">
      {%- render 'art-image', image: featured.featured_image, focus: featured.metafields.custom.image_focus.value, alt: featured.title, sizes: '200px' -%}
      <div>
        <p class="eyebrow">{{ section.settings.featured_label | escape }}</p>
        <h3>{{ featured.title | escape }}</h3>
        {%- if featured.metafields.custom.dimensions.value -%}<p class="muted">{{ featured.metafields.custom.dimensions.value }}</p>{%- endif -%}
        <span class="text-link">Explore {% render 'icon', icon: 'arrow' %}</span>
      </div>
    </a>
  {%- endif -%}
{%- endcapture -%}

<header class="site-header">
  <div class="header-inner">
    <div class="header-start">
      <button type="button" class="icon-btn menu-btn" data-open="menuPanel" aria-controls="menuPanel" aria-expanded="false" aria-label="Open menu">{% render 'icon', icon: 'menu' %}</button>
    </div>
    <a class="brand" href="{{ routes.root_url }}" aria-label="shalini mall, home">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 480 | image_tag: height: 40, alt: 'shalini mall' }}
      {%- else -%}
        <span>shalini mall</span>
      {%- endif -%}
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {%- for link in menu.links -%}
          {%- assign link_title = link.title | downcase | strip -%}
          <li>
            {%- if link_title == trigger and mega_columns != blank -%}
              <button type="button" class="nav-link" id="shopToggle" aria-expanded="false" aria-controls="megaShop"{% if link.child_active or link.active %} aria-current="page"{% endif %}>{{ link.title | escape }} {% render 'icon', icon: 'chevron' %}</button>
              <div class="mega" id="megaShop" role="region" aria-label="{{ link.title | escape }} menu">
                <div class="mega-inner">{{ mega_columns }}{{ mega_feature }}</div>
                <div class="mega-foot"><a class="text-link" href="{{ link.url }}">{{ section.settings.mega_all_label | escape }} {% render 'icon', icon: 'arrow' %}</a></div>
              </div>
            {%- else -%}
              <a class="nav-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="header-actions">
      <button type="button" class="icon-btn" data-open="searchPanel" aria-controls="searchPanel" aria-expanded="false" aria-label="Search">{% render 'icon', icon: 'search' %}</button>
      {%- if section.settings.wishlist_page != blank -%}
        <a class="icon-btn" href="{{ section.settings.wishlist_page.url }}" data-hide-xs data-wishlist-link aria-label="Wishlist">{% render 'icon', icon: 'heart' %}<span class="count-badge" data-wishlist-count></span></a>
      {%- endif -%}
      {%- comment -%} Account link: enable Shopify customer accounts and add a link here if wanted. {%- endcomment -%}
      <button type="button" class="icon-btn" data-open="cartPanel" aria-controls="cartPanel" aria-expanded="false" data-cart-link aria-label="Cart, {{ cart.item_count }} items">
        {%- render 'icon', icon: 'bag' -%}
        <span class="count-badge" data-cart-count data-count="{{ cart.item_count }}">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
      </button>
    </div>
  </div>
</header>

{%- comment -%} Moved to <body> by header.js so it layers above the sticky header. {%- endcomment -%}
<aside class="panel panel--left" id="menuPanel" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true" inert>
  <div class="panel-head">
    <a class="brand" href="{{ routes.root_url }}"><span>{{ shop.name | escape }}</span></a>
    <button type="button" class="icon-btn" data-close aria-label="Close menu">{% render 'icon', icon: 'close' %}</button>
  </div>
  <form class="menu-search" role="search" action="{{ routes.search_url }}" method="get">
    <label class="sr-only" for="menuSearch">Search artworks</label>
    {%- render 'icon', icon: 'search' -%}
    <input id="menuSearch" name="q" type="search" placeholder="Search artworks…" autocomplete="off">
  </form>
  <nav class="menu-nav" aria-label="Mobile">
    <ul class="menu-list">
      {%- for link in menu.links -%}
        {%- assign link_title = link.title | downcase | strip -%}
        <li>
          {%- if link_title == trigger and mega_columns != blank -%}
            <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="menuShop" data-menu-toggle>{{ link.title | escape }} {% render 'icon', icon: 'chevron' %}</button>
            <div class="menu-sub" id="menuShop" hidden>
              <a class="menu-sub__all" href="{{ link.url }}">{{ section.settings.mega_all_label | escape }}</a>
              <div class="menu-groups">{{ mega_columns | replace: 'mega-col', 'menu-group' | replace: '<h2>', '<h3>' | replace: '</h2>', '</h3>' }}</div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
  <div class="panel-foot menu-utility">
    {%- if section.settings.wishlist_page != blank -%}
      <a href="{{ section.settings.wishlist_page.url }}">{% render 'icon', icon: 'heart' %} Wishlist <span data-wishlist-count-text></span></a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}">{% render 'icon', icon: 'bag' %} Cart <span data-cart-count-text>{% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}</span></a>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Leave empty to use the script wordmark." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "mega_trigger", "label": "Mega menu trigger", "default": "Shop", "info": "Title of the menu item that opens the mega menu." },
    { "type": "text", "id": "mega_all_label", "label": "Mega menu 'view all' label", "default": "Shop all artwork" },
    { "type": "product", "id": "featured_product", "label": "Featured artwork" },
    { "type": "text", "id": "featured_label", "label": "Featured artwork label", "default": "Featured original" },
    { "type": "page", "id": "wishlist_page", "label": "Wishlist page", "info": "A page using the 'wishlist' template." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Mega menu column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Original art" },
        { "type": "link_list", "id": "menu", "label": "Links" }
      ]
    }
  ]
}
{% endschema %}
