{{ 'editorial.css' | asset_url | stylesheet_tag }}
{{ 'shop.css' | asset_url | stylesheet_tag }}
<div class="page">
  <header class="shop-head">
    {%- if section.settings.show_breadcrumb and page -%}{%- render 'breadcrumbs', current: page.title -%}{%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <{{ section.settings.heading_level }}>{{ section.settings.heading | escape }}</{{ section.settings.heading_level }}>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
  </header>
  {%- if section.blocks.size > 0 -%}
    <div class="info-grid" data-reveal-stagger>
      {%- for block in section.blocks -%}
        <article class="info-card" {{ block.shopify_attributes }}>
          {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="info-card__title">{{ block.settings.title | escape }}</h2>
          {{ block.settings.text }}
          {%- if block.settings.link_label != blank -%}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Intro with cards",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About the studio" },
    { "type": "select", "id": "heading_level", "label": "Heading level", "default": "h1", "options": [
      { "value": "h1", "label": "Page title (H1)" }, { "value": "h2", "label": "Section heading (H2)" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Art for slow, considered spaces." },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title", "default": "Original paintings" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Intro with cards" }]
}
{% endschema %}
