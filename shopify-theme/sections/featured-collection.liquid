{%- liquid
  assign c = section.settings.collection
-%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}{% if section.settings.flush_top %} section--flush-top{% endif %}" aria-labelledby="heading-{{ section.id }}">
  <div class="section-head section-head--split" data-reveal>
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if c != blank and section.settings.link_label != blank -%}
      <a class="text-link" href="{{ c.url }}">{{ section.settings.link_label | escape }} {% render 'icon', icon: 'arrow' %}</a>
    {%- endif -%}
  </div>
  <product-slider>
    <div class="product-grid product-grid--4 product-slider__track" id="featured-{{ section.id }}" tabindex="0" role="region" aria-roledescription="carousel" aria-labelledby="heading-{{ section.id }}">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for p in c.products limit: section.settings.limit -%}
          {%- if section.settings.numbered -%}
            {%- render 'product-card', card_product: p, index: forloop.index -%}
          {%- else -%}
            {%- render 'product-card', card_product: p -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <p class="muted">Choose a collection with products to show here.</p>
      {%- endif -%}
    </div>
  </product-slider>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the studio · One of one" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured originals" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "numbered", "label": "Number the works (Nº 01…)", "default": false },
    { "type": "checkbox", "id": "surface", "label": "White background", "default": false },
    { "type": "checkbox", "id": "flush_top", "label": "Remove top spacing", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
