{{ 'editorial.css' | asset_url | stylesheet_tag }}
<section class="section section--surface home-faq" id="faq-{{ section.id }}" aria-labelledby="faq-heading-{{ section.id }}">
  <div class="home-faq__layout">
    <div class="home-faq__intro">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="faq-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.text | escape }}</p>
      {% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', icon: 'arrow' %}</a>{% endif %}
    </div>
    <div class="faq">
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          {{ block.settings.answer }}
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Homepage FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A little guidance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you collect."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction",
      "default": "Answers to a few questions about choosing and bringing a work home."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Contact link label",
      "default": "Ask the studio"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Contact link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is the difference between an original and a print?",
            "answer": "<p>An original is the one-of-one painting itself. A print is a matte stretched-canvas reproduction, signed and numbered by the artist.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do originals include authentication?",
            "answer": "<p>Yes. Every original arrives signed with a studio certificate of authenticity.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What size should I choose?",
            "answer": "<p>Use the true-scale wall previews on each product page to see how the artwork will look in your space. You can also explore our <a href=\"/pages/about#print-sizes\">print size guide</a>.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How are works shipped?",
            "answer": "<p>All artwork is carefully packed. Originals travel insured with tracking, with complimentary shipping across India. Canvas prints are corner-protected and securely boxed.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I see more detail before I buy?",
            "answer": "<p>Of course. Contact the studio to request close-ups, scale images, or a short studio video of any available work.</p>"
          }
        }
      ],
      "settings": {
        "link": "shopify://pages/contact"
      }
    }
  ]
}
{% endschema %}
