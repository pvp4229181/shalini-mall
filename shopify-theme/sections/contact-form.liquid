{{ 'editorial.css' | asset_url | stylesheet_tag }}
{{ 'shop.css' | asset_url | stylesheet_tag }}
<div class="page">
  <header class="shop-head">
    {%- render 'breadcrumbs', current: page.title -%}
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
  </header>
  <div class="contact-grid">
    <section class="contact-card" aria-labelledby="formTitle-{{ section.id }}">
      <h2 id="formTitle-{{ section.id }}">Send a note</h2>
      {%- form 'contact', id: 'contactForm' -%}
        <div class="field"><label for="contactName">Name</label><input class="input" id="contactName" name="contact[name]" autocomplete="name" required value="{{ form.name }}"></div>
        <div class="field"><label for="contactEmail">Email</label><input class="input" id="contactEmail" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="contactStatus"{% endif %}></div>
        <div class="field"><label for="contactMessage">Message</label><textarea class="textarea" id="contactMessage" name="contact[body]" required>{{ form.body }}</textarea></div>
        <button class="button dark" type="submit">Send enquiry</button>
        <p class="form-message{% if form.errors %} is-error{% elsif form.posted_successfully? %} form-message--success{% endif %}" id="contactStatus" aria-live="polite">
          {%- if form.posted_successfully? -%}
            Thank you. Your note has been sent to the studio.
          {%- elsif form.errors -%}
            {{ form.errors | default_errors }}
          {%- endif -%}
        </p>
      {%- endform -%}
    </section>
    {%- if section.blocks.size > 0 -%}
      <section class="contact-card faq" id="faq" aria-labelledby="faqTitle-{{ section.id }}">
        <p class="eyebrow">Frequently asked</p>
        <h2 id="faqTitle-{{ section.id }}">{{ section.settings.faq_heading | escape }}</h2>
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary>{{ block.settings.answer }}</details>
        {%- endfor -%}
      </section>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Studio enquiries" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let’s talk art." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions about a work, commissions, shipping or press — send a note to the studio." },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Before you collect." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
