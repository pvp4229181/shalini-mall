<section class="section{% if section.settings.surface %} section--surface{% endif %}" aria-labelledby="heading-{{ section.id }}">
  <div class="section-head" data-reveal>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 id="heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.link_label != blank -%}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet Shalini." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "surface", "label": "White background", "default": false }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
