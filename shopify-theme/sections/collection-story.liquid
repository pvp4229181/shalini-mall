{{ 'shop.css' | asset_url | stylesheet_tag }}
{%- comment -%} A series' story, from collection metafields custom.heading / custom.story (falls back to the description). {%- endcomment -%}
{%- liquid
  assign heading = collection.metafields.custom.heading.value | default: section.settings.heading
  assign story = collection.metafields.custom.story.value
-%}
{%- if story != blank or collection.description != blank -%}
  <section class="section section--surface" aria-labelledby="heading-{{ section.id }}">
    <div class="collection-story" data-reveal>
      <div><p class="eyebrow">The story</p><h2 id="heading-{{ section.id }}">{{ heading | escape }}</h2></div>
      <div class="collection-story__body">
        {%- if story != blank -%}<p>{{ story | escape | newline_to_br }}</p>{%- else -%}{{ collection.description }}{%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection story",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading when the collection has none", "default": "About the series" }
  ]
}
{% endschema %}
