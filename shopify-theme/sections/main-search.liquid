{{ 'shop.css' | asset_url | stylesheet_tag }}
<div class="page">
  <header class="shop-head">
    {%- render 'breadcrumbs', current: 'Search' -%}
    <h1>{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Search{% endif %}</h1>
    <form class="search-page-form" role="search" action="{{ routes.search_url }}" method="get">
      <label class="sr-only" for="searchPageInput">Search artworks</label>
      <input class="input" id="searchPageInput" name="q" type="search" value="{{ search.terms | escape }}" placeholder="Title, collection, size…" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="button dark" type="submit">Search</button>
    </form>
    <p aria-live="polite">
      {%- if search.performed and search.results_count > 0 -%}{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}
      {%- elsif search.performed == false -%}Search by title, collection, size, or “original” and “print”.{%- endif -%}
    </p>
  </header>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <h2 class="sr-only">Matching artworks</h2>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{%- render 'product-card', card_product: item -%}{%- endif -%}
        {%- endfor -%}
      </div>
      {%- if search.results_count == 0 -%}
        <div class="empty-state">
          <h2>No artwork found</h2>
          <p>Try a title, a collection name, or simply “original” or “print”.</p>
          <a class="text-link" href="{{ routes.all_products_collection_url }}">Explore all works</a>
        </div>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="load-more" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
