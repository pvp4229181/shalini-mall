<section class="newsletter" id="newsletter" aria-labelledby="newsletterTitle-{{ section.id }}">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  <h2 id="newsletterTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
  {%- form 'customer', id: 'newsletterForm', novalidate: 'novalidate' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label class="sr-only" for="newsletterEmail-{{ section.id }}">Email address</label>
    <input class="input" id="newsletterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required
      {% if form.errors %}aria-invalid="true" aria-describedby="newsletterMsg-{{ section.id }}"{% endif %}>
    <button class="button dark" type="submit">{{ section.settings.button | escape }} {% render 'icon', icon: 'arrow' %}</button>
    <p class="form-message{% if form.errors %} is-error{% elsif form.posted_successfully? %} form-message--success{% endif %}" id="newsletterMsg-{{ section.id }}" aria-live="polite">
      {%- if form.posted_successfully? -%}
        {{ 'newsletter.success' | t }}
      {%- elsif form.errors -%}
        {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
      {%- endif -%}
    </p>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Notes from the studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Art, process, and new work—occasionally." },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
