{%- comment -%}
  Collector testimonials. Only genuine reviews should be added (with the collector's permission).
  The section renders nothing until at least one testimonial block exists.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="section reviews" data-testimonials aria-labelledby="heading-{{ section.id }}">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="review-track" id="reviewTrack" aria-roledescription="carousel" aria-label="Collector reviews" tabindex="0">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <figure class="review-card" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}" {{ block.shopify_attributes }}>
          <div class="review-body">
            {%- if block.settings.rating > 0 -%}
              {%- assign empty_stars = 5 | minus: block.settings.rating -%}
              <span class="review-stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}{% if empty_stars > 0 %}{% for i in (1..empty_stars) %}☆{% endfor %}{% endif %}</span>
            {%- endif -%}
            <blockquote>{{ block.settings.quote | escape }}</blockquote>
            {%- if p != blank -%}
              <a class="review-thumb" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{% render 'art-image', image: p.featured_image, focus: p.metafields.custom.image_focus.value, alt: '', sizes: '65px' %}</a>
            {%- endif -%}
            <figcaption>
              <cite>{{ block.settings.name | escape }}</cite>
              {%- if block.settings.place != blank -%}<span>{{ block.settings.place | escape }}</span>{%- endif -%}
              {%- if p != blank -%}<a class="review-piece" href="{{ p.url }}">Collected: {{ p.title | escape }}</a>{%- endif -%}
            </figcaption>
          </div>
        </figure>
      {%- endfor -%}
    </div>
    <div class="review-dots" id="reviewDots"></div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collector testimonials",
  "settings": [
    { "type": "paragraph", "content": "Add only genuine reviews, with the collector's permission." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In collectors’ homes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What collectors are saying" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "place", "label": "Location" },
        { "type": "range", "id": "rating", "label": "Rating (0 hides stars)", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "product", "id": "product", "label": "Artwork collected" }
      ]
    }
  ],
  "presets": [{ "name": "Collector testimonials" }]
}
{% endschema %}
