{{ 'shop.css' | asset_url | stylesheet_tag }}
{{ 'collections.css' | asset_url | stylesheet_tag }}
{%- liquid
  if section.settings.collections.count > 0
    assign list = section.settings.collections
  else
    assign list = collections
  endif
  assign fallback_src = section.settings.fallback_image | append: '.webp' | asset_url
-%}
{%- assign theme_handles = 'abstract,nature-landscapes,floral-botanical,figurative,modern-minimal,cultural-traditional,wildlife,cityscapes-architecture' | split: ',' -%}
<div class="page collections-page">
  {%- render 'breadcrumbs', current: section.settings.heading -%}
  <header class="collections-intro">
    <div class="collections-intro__copy">
      <p class="eyebrow">The studio collection</p><h1>Different worlds.<br>One love for art.</h1>
      <p>From quiet landscapes to expressive abstracts, find a collection that feels like you. Every theme brings together originals and fine art prints.</p>
      <a class="button dark" href="#collectionDirectory">Discover the collections {% render 'icon', icon: 'arrow' %}</a>
      <p class="collections-intro__note">Chosen by feeling. Collected with care.</p>
    </div>
    <div class="collections-intro__art">
      <img src="{{ 'mineral-rhythm-hq.webp' | asset_url }}" alt="Mineral Rhythm abstract painting" width="1024" height="1536" decoding="async">
      <img src="{{ 'ivory-bloom-hq.webp' | asset_url }}" alt="Ivory Bloom floral painting" width="1024" height="1536" fetchpriority="high" decoding="async">
      <img src="{{ 'mountain-stillness-hq.webp' | asset_url }}" alt="Mountain Stillness landscape painting" width="1024" height="1536" decoding="async">
      <span>Art for the way you see the world.</span>
    </div>
  </header>
  <section id="collectionDirectory" aria-labelledby="directoryTitle">
    <div class="collections-directory-head"><div><p class="eyebrow">Explore by theme</p><h2 id="directoryTitle">Find your next favourite.</h2></div><p>Eight themes to explore</p></div>
    <nav class="collections-jump" aria-label="Jump to a collection">
      {%- for handle in theme_handles -%}{%- assign c = collections[handle] -%}
        {%- if c != blank -%}<a href="#theme-{{ handle }}">{{ c.title | escape }}</a>{%- endif -%}
      {%- endfor -%}
    </nav>
    <div class="collections-grid">
      {%- for handle in theme_handles -%}{%- assign c = collections[handle] -%}
        {%- if c == blank -%}{%- continue -%}{%- endif -%}
        <article class="collection-tile" id="theme-{{ handle }}">
          <a class="collection-tile__art" href="{{ c.url }}" aria-label="Explore {{ c.title | escape }}">
            <span class="collection-tile__number">0{{ forloop.index }}</span>
            {%- assign originals = c.products | where: 'type', 'Original' -%}
            {%- for p in originals limit: 2 -%}{%- render 'art-image', image: p.featured_image, alt: p.title, sizes: '(min-width: 1024px) 15vw, 40vw' -%}{%- endfor -%}
          </a>
          <div class="collection-tile__heading"><h3><a href="{{ c.url }}">{{ c.title | escape }}</a></h3><a class="collection-tile__arrow" href="{{ c.url }}" aria-label="Explore {{ c.title | escape }}">{% render 'icon', icon: 'arrow' %}</a></div>
          <p>{{ c.description | strip_html }}</p>
          <div class="collection-tile__meta"><span>{{ c.all_products_count }} works</span><a href="{{ collections.originals.url }}?filter.p.tag={{ handle }}">Originals</a><span aria-hidden="true">/</span><a href="{{ collections.prints.url }}?filter.p.tag={{ handle }}">Prints</a></div>
        </article>
      {%- endfor -%}
    </div>
  </section>
  <aside class="collections-help"><div><p class="eyebrow">A little guidance</p><h2>Still finding your favourite?</h2><p>Tell us about your space and the art you love. We’ll help you find a work that belongs.</p></div><a class="button outline" href="{{ pages.contact.url }}">Ask the studio</a></aside>
</div>
{% comment %}Additional merchant-selected collections remain available below the theme directory.{% endcomment %}
<div class="page">
  <header class="shop-head">
    {%- render 'breadcrumbs', current: section.settings.heading -%}
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
  </header>
  <div class="collection-list">
    {%- for c in list -%}
      {%- if theme_handles contains c.handle or c.handle == 'originals' or c.handle == 'prints' -%}{%- continue -%}{%- endif -%}
      {%- if c.handle == 'all' or c.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
      <article class="collection-feature">
        {%- if c.image -%}
          {%- render 'art-image', image: c.image, focus: c.metafields.custom.image_focus.value, alt: c.title, sizes: '(min-width: 1024px) 58vw, 100vw' -%}
        {%- else -%}
          {%- render 'art-image', src: fallback_src, focus: 'center', alt: c.title -%}
        {%- endif -%}
        <div class="collection-feature__copy">
          {%- if c.metafields.custom.eyebrow.value != blank -%}<p class="eyebrow">{{ c.metafields.custom.eyebrow.value | escape }}</p>{%- endif -%}
          <h2><a href="{{ c.url }}">{{ c.title | escape }}</a></h2>
          {%- if c.description != blank -%}<p>{{ c.description | strip_html | truncatewords: 40 }}</p>{%- endif -%}
          <div class="collection-feature__strip" aria-hidden="true">
            {%- for p in c.products limit: 4 -%}
              {%- render 'art-image', image: p.featured_image, focus: p.metafields.custom.image_focus.value, alt: '', sizes: '90px' -%}
            {%- endfor -%}
          </div>
          <p class="collection-feature__meta">{{ c.all_products_count }} works</p>
          <a class="button dark" href="{{ c.url }}">Explore the collection</a>
        </div>
      </article>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Series from the studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Bodies of work made together, each with its own palette, story and mood — shown here as originals and signed editions." },
    { "type": "select", "id": "fallback_image", "label": "Image for collections without one", "default": "earth-song", "options": [{"value": "hero-gallery", "label": "Painting in a room"}, {"value": "earth-song", "label": "Earth Song"}, {"value": "wild-grace", "label": "Wild Grace"}, {"value": "quiet-orbit", "label": "Quiet Orbit"}, {"value": "small-hours", "label": "The Small Hours"}, {"value": "between-seasons", "label": "Between Seasons"}, {"value": "monsoon-memory", "label": "Monsoon Memory"}, {"value": "artist-shalini", "label": "Shalini (portrait)"}, {"value": "artist-studio", "label": "Studio table"}, {"value": "collection-hero", "label": "Collection detail"}] },
    { "type": "collection_list", "id": "collections", "label": "Collections to show", "info": "Leave empty to list every collection." }
  ]
}
{% endschema %}
