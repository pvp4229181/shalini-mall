{{ 'home.css' | asset_url | stylesheet_tag }}
<section class="section" aria-labelledby="heading-{{ section.id }}">
  <div class="section-head section-head--split" data-reveal>
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </div>
  <div class="art-types" data-reveal>
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign url = block.settings.link | default: c.url
        assign fallback_src = block.settings.fallback_image | append: '.webp' | asset_url
        assign meta = block.settings.meta
        if meta == blank and c != blank
          assign min_price = c.products | map: 'price' | sort | first
          assign meta = c.products_count | append: ' works'
          if min_price
            assign min_money = min_price | money
            assign meta = meta | append: ' · from ' | append: min_money
          endif
        endif
      -%}
      <a class="art-type" href="{{ url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {%- render 'art-image', image: block.settings.image, alt: '', sizes: '(min-width: 768px) 33vw, 100vw' -%}
        {%- elsif c.featured_image -%}
          {%- render 'art-image', image: c.featured_image, alt: '', sizes: '(min-width: 768px) 33vw, 100vw' -%}
        {%- else -%}
          {%- render 'art-image', src: fallback_src, focus: block.settings.fallback_focus, alt: '' -%}
        {%- endif -%}
        <div class="art-type__copy">
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          {%- if meta != blank -%}<p class="art-type__meta">{{ meta }}</p>{%- endif -%}
          <span class="text-link">{{ block.settings.cta | escape }} {% render 'icon', icon: 'arrow' %}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by art type",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collect what moves you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by art type" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all artwork" },
    { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 3,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Used for the link, count and starting price." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "fallback_image", "label": "Image before one is chosen", "default": "earth-song", "options": [{"value": "hero-gallery", "label": "Painting in a room"}, {"value": "earth-song", "label": "Earth Song"}, {"value": "wild-grace", "label": "Wild Grace"}, {"value": "quiet-orbit", "label": "Quiet Orbit"}, {"value": "small-hours", "label": "The Small Hours"}, {"value": "between-seasons", "label": "Between Seasons"}, {"value": "monsoon-memory", "label": "Monsoon Memory"}, {"value": "artist-shalini", "label": "Shalini (portrait)"}, {"value": "artist-studio", "label": "Studio table"}, {"value": "collection-hero", "label": "Collection detail"}] },
        { "type": "text", "id": "fallback_focus", "label": "Focus before an image is chosen", "default": "center" },
        { "type": "text", "id": "title", "label": "Title", "default": "Original art" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "meta", "label": "Small text", "info": "Leave empty to show the collection's count and starting price." },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link (overrides collection)" }
      ]
    }
  ],
  "presets": [{ "name": "Shop by art type", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
