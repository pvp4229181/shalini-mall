<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand" href="{{ routes.root_url }}"><span>{{ shop.name | escape }}</span></a>
        {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline | escape }}</p>{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        <div class="footer-col" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
      {%- if settings.social_instagram != blank or settings.social_pinterest != blank or settings.social_facebook != blank -%}
        <div class="footer-col">
          <h2>Follow</h2>
          <ul>
            {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener">Instagram</a></li>{%- endif -%}
            {%- if settings.social_pinterest != blank -%}<li><a href="{{ settings.social_pinterest }}" rel="noopener">Pinterest</a></li>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener">Facebook</a></li>{%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
    <div class="legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
      {%- comment -%} Policy pages come from Shopify admin → Settings → Policies. {%- endcomment -%}
      {%- if shop.policies.size > 0 -%}
        <span class="legal__links">
          {%- for policy in shop.policies -%}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% unless forloop.last %} · {% endunless %}
          {%- endfor -%}
        </span>
      {%- endif -%}
      <span>Prices shown in {{ cart.currency.iso_code }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Art for slow, considered spaces. Original paintings and signed fine art prints." }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
